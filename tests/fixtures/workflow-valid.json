{
  "name": "test-campaign",
  "title": "Test Campaign",
  "contents": {
    "name": "workflow",
    "version": "1.0.0",
    "schema": {
      "input": {},
      "output": {
        "final_video": {
          "name": "final_video",
          "label": "Reklam videosu",
          "type": "string"
        }
      }
    },
    "output": {
      "final_video": "$fal_ai/kling/v2_1.video.url"
    },
    "nodes": {
      "node-hero": {
        "type": "run",
        "id": "node-hero",
        "app": "fal-ai/flux/dev",
        "depends": [],
        "input": { "prompt": "a woman in her early thirties, beige linen shirt" }
      },
      "fal_ai/kling/v2_1": {
        "type": "run",
        "id": "fal_ai/kling/v2_1",
        "app": "fal-ai/kling-video/v2/image-to-video",
        "depends": ["node-hero"],
        "input": {
          "image_url": "$node-hero.images.0.url",
          "duration": 8
        }
      },
      "output": {
        "type": "display",
        "id": "output",
        "depends": ["fal_ai/kling/v2_1"],
        "fields": { "final_video": "$fal_ai/kling/v2_1.video.url" }
      }
    }
  }
}
